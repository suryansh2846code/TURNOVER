.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.env
*.db
*.db-wal
*.db-shm
google_token.json

# never commit personal OAuth secrets (per-user Web/token clients & tokens)
client_secret*.json
google_client_secret.json

# NOTE: lodestone/data/google_client.json IS committed on purpose — it is an
# "installed" (Desktop app) OAuth client. Google treats installed-app secrets as
# non-confidential (security is PKCE + the localhost redirect), so shipping it
# gives testers one-click sign-in. If GitHub secret-scanning ever revokes it,
# regenerate a Desktop client in Cloud Console and replace this file.
